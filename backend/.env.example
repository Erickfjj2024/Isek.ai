# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Dashboard → Settings → API → JWT Secret (usado para validar os tokens de acesso)
SUPABASE_JWT_SECRET=your-jwt-secret

# LLM — "groq" (console.groq.com) ou "gemini" (aistudio.google.com), ambos com tier gratuito
LLM_PROVIDER=groq
LLM_API_KEY=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
# Opcional: deixe vazio para usar o padrão do provedor
# (groq → llama-3.3-70b-versatile | gemini → gemini-2.5-flash)
LLM_MODEL=

# App
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALLOWED_ORIGINS=http://localhost:3000

# Mana config
MANA_COST_PER_STORY=10
MANA_WELCOME_BONUS=100
